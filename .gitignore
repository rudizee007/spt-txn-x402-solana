# ── Key material — NEVER commit ────────────────────────────────────────────
# Solana keypairs are secrets even on devnet. Keys come from $SOL_OPERATOR_KEY.
*keypair*.json
*-devnet.json
*-mainnet.json
id.json
*.pem
*.key
.env
.env.*

# ── Build artifacts ────────────────────────────────────────────────────────
# /bin/ holds locally compiled binaries (e.g. spt-txn-mcp). A committed binary is
# unreviewable, unreproducible, and goes stale silently — build it, don't ship it.
/bin/
/gate/gate
/settle/settle
/settle/sol-pay
**/target/
node_modules/
dist/
*.so
*.test

# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Runtime evidence ───────────────────────────────────────────────────────
# Written by cmd/x402demo, read by cmd/anchordevnet. Holds no key material —
# the receipt-signing private key is never serialized — but it is per-run
# output, not source, and committing it invites anchoring a stale root.
receipts.json
receipts-*.json

# Written by `cmd/escrowdevnet -mode deposit`, read by `-mode release`. Holds the
# escrow's PUBLIC parameters only — no key material — but it is per-run output.
escrow-ticket.json
escrow-ticket-*.json
